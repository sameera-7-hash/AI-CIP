# Copy this file to .env and adjust as needed.

# Where the vLLM OpenAI-compatible server is reachable from the gateway.
VLLM_BASE_URL=http://localhost:8000/v1

# Must match the --served-model-name (or model path) vLLM was started with.
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Host/port the FastAPI gateway itself listens on.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Seconds to wait on a tool call before falling back to inference-only.
TOOL_TIMEOUT_SECONDS=3
